{
  "name": "arrazi",
  "productName": "Arrazi",
  "version": "1.0.0",
  "description": "Learn new skills, played like a game.",
  "author": "Arrazi",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "dev": "node scripts/build.mjs && electron . --dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "icons": "node scripts/make-icons.mjs",
    "preview": "node scripts/build.mjs --preview",
    "dist": "node scripts/build.mjs && electron-builder --win --x64 --publish never",
    "dist:portable": "node scripts/build.mjs && electron-builder --win portable zip --x64 --publish never",
    "test:e2e": "node scripts/build.mjs --preview && node tools/e2e.mjs"
  },
  "devDependencies": {
    "@fontsource/jersey-10": "^5.3.0",
    "@fontsource/micro-5": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/tiny5": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resedit": "^3.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "build": {
    "appId": "com.arrazi.app",
    "productName": "Arrazi",
    "copyright": "Arrazi",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "protocols": [
      {
        "name": "Arrazi",
        "schemes": [
          "arrazi"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Arrazi",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "afterPack": "scripts/after-pack.cjs"
  }
}